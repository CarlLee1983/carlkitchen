{
  "name": "carlkitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && node scripts/build-search-index.mjs",
    "preview": "astro preview",
    "check": "pnpm format:check && astro check && pnpm build",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:e2e-meal": "RECIPES_DIR=tests/fixtures/meal-recipes ASTRO_OUT_DIR=dist-meal astro build --force",
    "test:e2e": "RECIPES_DIR=tests/fixtures/recipes INGREDIENTS_DIR=tests/fixtures/ingredients INGREDIENT_SOURCES_DIR=tests/fixtures/ingredient-sources pnpm build && pnpm build:e2e-meal && node scripts/run-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.2.9",
    "pagefind": "1.5.2",
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "wrangler": "4.147.0",
    "yaml": "2.8.3"
  }
}
