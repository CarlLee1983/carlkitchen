{
  "name": "carlkitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && node scripts/build-search-index.mjs",
    "preview": "astro preview",
    "check": "pnpm format:check && astro check && pnpm build",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "check:merge": "node --experimental-strip-types scripts/check-merge.ts",
    "measure:mobile": "node --experimental-strip-types scripts/measure-mobile.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:e2e-meal": "RECIPES_DIR=tests/fixtures/meal-recipes SOLAR_TERMS_DIR=tests/fixtures/solar-terms-empty ASTRO_OUT_DIR=dist-meal astro build --force",
    "build:e2e": "RECIPES_DIR=tests/fixtures/recipes INGREDIENTS_DIR=tests/fixtures/ingredients TOPICS_DIR=tests/fixtures/topics SOLAR_TERMS_DIR=tests/fixtures/solar-terms INGREDIENT_SOURCES_DIR=tests/fixtures/ingredient-sources pnpm build",
    "build:e2e-show-more": "HOME_BATCH_SIZE=1 ASTRO_OUT_DIR=dist-show-more pnpm build:e2e",
    "test:e2e": "pnpm build:e2e && pnpm build:e2e-meal && pnpm build:e2e-show-more && node scripts/run-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.2.9",
    "astronomy-engine": "2.1.19",
    "pagefind": "1.5.2",
    "satteri": "0.10.5",
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "wrangler": "4.147.0",
    "yaml": "2.8.3"
  }
}
