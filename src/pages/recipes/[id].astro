---
import Base from "../../layouts/Base.astro";
import Illustration from "../../components/Illustration.astro";
import { formatAmount, groupIngredients } from "../../utils/ingredients";
import { recipeKinds } from "../../utils/home";
import {
  getVisibleIngredientEntries,
  type IngredientEntry,
} from "../../utils/ingredient-entries";
import { getVisibleRecipes } from "../../utils/recipes";
import type { Recipe } from "../../utils/recipes";

export async function getStaticPaths() {
  const [recipes, ingredients] = await Promise.all([
    getVisibleRecipes(),
    getVisibleIngredientEntries(),
  ]);
  // 公開菜譜只連至已發布食材；草稿食材在開發模式仍可直訪預覽。
  const publishedIngredients = ingredients.filter((entry) => !entry.data.draft);
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: {
      recipe,
      relatedIngredients: publishedIngredients
        .filter((entry) => entry.data.relatedRecipes.includes(recipe.id))
        .sort(
          (left, right) =>
            left.data.title.localeCompare(right.data.title, "zh-Hant") ||
            left.id.localeCompare(right.id),
        ),
    },
  }));
}

interface Props {
  recipe: Recipe;
  relatedIngredients: IngredientEntry[];
}
const { data, id } = Astro.props.recipe;
const { relatedIngredients } = Astro.props;
const groups = groupIngredients(data.ingredients);
// 讀者看不到、但要能搜到的詞：受控標籤與別名。
const searchTerms = [...data.tags, ...data.aliases];

// sizes 對應下方 CSS：寬螢幕主欄與成品圖上限 44rem，手機單欄約等於視窗寬。
const MAIN_SIZES = "(min-width: 64rem) 44rem, 100vw";
const SIDE_SIZES = "(min-width: 64rem) 20rem, 100vw";
---

<Base title={data.title}>
  <!--
    Pagefind 索引範圍：整個站只要有 data-pagefind-body，沒有標記的頁面（首頁、關於頁等）就不進索引。
    這裡只標記可搜尋的欄位：菜名（加權）、摘要、材料名稱、受控標籤與別名；
    步驟、小提醒不標記；材料行內的用量與備註要明確 ignore（Pagefind 會把行內相鄰文字一起收進去）；圖片替代文字由 Illustration 的 data-pagefind-ignore="all" 排除。
    性質以篩選屬性 kind 提供，值與首頁網址的 kind 參數相同；每個值各用一個元素輸出，一道菜可帶多個值。
  -->
  <article class="recipe">
    {
      recipeKinds(data).map((kind) => (
        <span hidden data-pagefind-filter={`kind:${kind}`} />
      ))
    }
    <header class="recipe-head">
      <h1 data-pagefind-body data-pagefind-weight="10">
        {data.title}{data.draft && <span>（草稿）</span>}
      </h1>
      <p class="summary" data-pagefind-body>{data.summary}</p>
      {
        searchTerms.length > 0 && (
          <p hidden data-pagefind-body>
            {searchTerms.join(" ")}
          </p>
        )
      }
      <p class="recipe-meta">
        <span>{data.servings} 人份</span>
        <span>{data.timeMinutes} 分鐘</span>
        <span>{data.category}</span>
      </p>
      {
        !data.draft && (
          <div class="favorite-actions">
            <button
              type="button"
              data-favorite-id={id}
              aria-pressed="false"
              hidden
            >
              收藏這道菜
            </button>
            <span data-favorite-state hidden />
            <p data-favorite-error role="alert" />
          </div>
        )
      }
    </header>

    {
      data.hero && (
        <Illustration
          class="hero"
          image={data.hero}
          sizes={MAIN_SIZES}
          priority
        />
      )
    }

    <div class="recipe-body">
      <aside class="ingredients" aria-labelledby="ingredients-title">
        <h2 id="ingredients-title">材料</h2>
        {
          data.ingredientsPhoto && (
            <Illustration image={data.ingredientsPhoto} sizes={SIDE_SIZES} />
          )
        }
        {
          groups.map((group) => (
            <section>
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((ingredient) => (
                  <li>
                    <span>
                      <span data-pagefind-body>{ingredient.name}</span>{" "}
                      <span data-pagefind-ignore>
                        {formatAmount(ingredient.amount)}
                      </span>
                    </span>
                    {ingredient.note && (
                      <small data-pagefind-ignore>（{ingredient.note}）</small>
                    )}
                    {ingredient.image && (
                      <Illustration
                        class="ingredient-thumb"
                        image={ingredient.image}
                        sizes="6rem"
                      />
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </aside>

      <section class="method" aria-labelledby="method-title">
        <h2 id="method-title">做法</h2>
        <ol class="steps">
          {
            data.steps.map((step) => (
              <li>
                <p>{step.text}</p>
                {step.image && (
                  <Illustration image={step.image} sizes={MAIN_SIZES} />
                )}
              </li>
            ))
          }
        </ol>
        {
          data.tip && (
            <section class="tip">
              <h2>小提醒</h2>
              <p>{data.tip}</p>
            </section>
          )
        }
      </section>
    </div>

    {
      relatedIngredients.length > 0 && (
        <section
          class="ingredient-guide"
          aria-labelledby="ingredient-guide-title"
        >
          <h2 id="ingredient-guide-title">了解食材</h2>
          <ul>
            {relatedIngredients.map((ingredient) => (
              <li>
                <a href={`/ingredients/${ingredient.id}/`}>
                  {ingredient.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="disclaimer" aria-label="聲明">
      <p>依公開資料整理、站主審閱，未經試做</p>
    </section>
  </article>
</Base>

<script>
  import { initRecipeFavorite } from "../../scripts/favorites";

  initRecipeFavorite();
</script>

<style>
  .recipe-head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .recipe-head h1 {
    margin: 0 0 1rem;
    font-size: 2.25rem;
  }
  .summary {
    margin: 0 0 1rem;
  }
  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .favorite-actions {
    margin-top: 1rem;
  }
  .favorite-actions span {
    margin-left: 0.75rem;
    color: var(--ink-soft);
  }
  .favorite-actions button {
    min-width: 44px;
    min-height: 44px;
    padding: 0.35rem 1rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .favorite-actions button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  .favorite-actions button[hidden],
  .favorite-actions span[hidden],
  .favorite-actions p:empty {
    display: none;
  }
  .favorite-actions p {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  /* 以下 :global 選取 Illustration 元件內部的 figure */
  .recipe :global(.hero) {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .recipe-body {
    display: grid;
    gap: 3rem;
  }
  .ingredients h2,
  .method h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.25rem;
  }
  .ingredients h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
  }
  .ingredients ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ingredients li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ingredients li small {
    color: var(--ink-soft);
  }
  .ingredients :global(.ingredient-thumb) {
    width: 6rem;
    margin-top: 0.4rem;
  }
  .ingredients > :global(figure) {
    margin-bottom: 1rem;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps > li {
    position: relative;
    margin-bottom: 2.5rem;
    padding-left: 2.5rem;
    counter-increment: step;
  }
  .steps > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--ink-soft);
  }
  .steps > li p {
    margin: 0 0 0.75rem;
  }
  .tip {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .tip h2 {
    border-bottom: 0;
  }

  .ingredient-guide {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .ingredient-guide h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }
  .ingredient-guide ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ingredient-guide a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    text-underline-offset: 0.25em;
  }

  .disclaimer {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .disclaimer p {
    margin: 0;
  }

  /* 寬螢幕：材料在左欄、捲動做法時保持可見（只 sticky，不設捲動區）；手機單欄 */
  @media (min-width: 64rem) {
    .recipe-body {
      grid-template-columns: 20rem minmax(0, 44rem);
      gap: 4rem;
      align-items: start;
    }
    .ingredients {
      position: sticky;
      top: 1.5rem;
    }
  }

  /* 列印：只留成品圖、材料與做法；步驟圖與材料合照不印，確保一張紙 */
  @media print {
    .disclaimer,
    .ingredient-guide,
    .favorite-actions,
    .ingredients :global(figure),
    .steps :global(figure) {
      display: none;
    }
    .recipe :global(.hero) {
      max-width: 14rem;
      margin-bottom: 1rem;
    }
    .recipe-body {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
    .steps > li {
      break-inside: avoid;
    }
  }
</style>
