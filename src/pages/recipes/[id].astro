---
import RecipeActionIcon from "../../components/RecipeActionIcon.astro";
import Base from "../../layouts/Base.astro";
import Illustration from "../../components/Illustration.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import { formatAmount, groupIngredients } from "../../utils/ingredients";
import { recipeKinds, recipeKindLabels } from "../../utils/home";
import {
  getVisibleIngredientEntries,
  type IngredientEntry,
} from "../../utils/ingredient-entries";
import { getVisibleRecipes } from "../../utils/recipes";
import type { Recipe } from "../../utils/recipes";
import {
  getVisibleTopicEntries,
  type TopicEntry,
} from "../../utils/topic-entries";
import { getRelatedTopics } from "../../utils/related-topics";
import { relatedRecipeIds } from "../../utils/related-recipes";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { SITE_NAME } from "../../utils/site";

export async function getStaticPaths() {
  const [recipes, ingredients, topics] = await Promise.all([
    getVisibleRecipes(),
    getVisibleIngredientEntries(),
    getVisibleTopicEntries(),
  ]);
  // 公開菜譜只連至已發布食材；草稿食材在開發模式仍可直訪預覽。
  const publishedIngredients = ingredients.filter((entry) => !entry.data.draft);
  // 不用 filterDrafts(recipes, DEV)：開發模式的可見菜譜含草稿，但相關菜譜也必須永遠排除草稿，
  // 所以這裡無條件只留已發布的；草稿頁自己沒有相關菜譜。
  const published = recipes.filter((recipe) => !recipe.data.draft);
  const related = relatedRecipeIds(
    published.map(({ id, data }) => ({ id, ...data })),
  );
  const publishedById = new Map(published.map((recipe) => [recipe.id, recipe]));
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: {
      recipe,
      relatedIngredients: publishedIngredients
        .filter((entry) => entry.data.relatedRecipes.includes(recipe.id))
        .sort(
          (left, right) =>
            left.data.title.localeCompare(right.data.title, "zh-Hant") ||
            left.id.localeCompare(right.id),
        ),
      relatedTopics: getRelatedTopics(recipe.id, topics),
      relatedRecipes: (related.get(recipe.id) ?? []).map((id) =>
        publishedById.get(id)!,
      ),
    },
  }));
}

interface Props {
  recipe: Recipe;
  relatedIngredients: IngredientEntry[];
  relatedTopics: TopicEntry[];
  relatedRecipes: Recipe[];
}
const { data, id } = Astro.props.recipe;
const { relatedIngredients, relatedTopics, relatedRecipes } = Astro.props;
const groups = groupIngredients(data.ingredients);
const hasPrintSheet = existsSync(
  join(process.cwd(), "public", "prints", `${id}.webp`),
);
const printDense =
  data.ingredients.length >= 12 ||
  data.steps.length >= 8 ||
  data.steps.reduce((total, step) => total + step.text.length, 0) >= 280;
const recipeJsonLd =
  !data.draft &&
  data.hero &&
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Recipe",
    name: data.title,
    description: data.summary,
    image: new URL(`/recipes/${id}/social.webp`, Astro.site).href,
    recipeYield: `${data.servings} 人份`,
    totalTime: `PT${data.timeMinutes}M`,
    recipeIngredient: groups.flatMap((group) =>
      group.items.map(
        (ingredient) =>
          `${ingredient.name} ${formatAmount(ingredient.amount)}${ingredient.note ? `（${ingredient.note}）` : ""}`,
      ),
    ),
    recipeInstructions: data.steps.map((step) => ({
      "@type": "HowToStep",
      text: step.text,
    })),
  }).replace(/</g, "\\u003c");
// 讀者看不到、但要能搜到的詞：受控標籤與別名。
const searchTerms = [...data.tags, ...data.aliases];

// sizes 對應下方 CSS：手機單欄為視窗寬扣掉左右 1.5rem 頁面留白；成品圖上限 44rem，步驟圖再扣 2.5rem 編號縮排。
const MAIN_SIZES = "(min-width: 47rem) 44rem, calc(100vw - 3rem)";
const SIDE_SIZES = "(min-width: 64rem) 20rem, calc(100vw - 3rem)";
// 相關菜譜卡片：手機兩欄、寬螢幕四欄，欄距 1rem；頁面內容寬上限 72rem 扣左右留白 3rem。
const RELATED_SIZES =
  "(min-width: 72rem) 16.5rem, (min-width: 40rem) calc((100vw - 6rem) / 4), calc((100vw - 4rem) / 2)";
const STEP_SIZES = "(min-width: 64rem) 41.5rem, calc(100vw - 5.5rem)";
---

<Base
  title={data.title}
  description={data.summary}
  socialImage={data.hero && {
    src: `/recipes/${id}/social.webp`,
    alt: data.hero.alt,
    width: 1200,
    height: 630,
  }}
>
  {
    recipeJsonLd && (
      <script type="application/ld+json" set:html={recipeJsonLd} />
    )
  }
  <!--
    Pagefind 索引範圍：整個站只要有 data-pagefind-body，沒有標記的頁面（首頁、關於頁等）就不進索引。
    這裡只標記可搜尋的欄位：菜名（加權）、摘要、材料名稱、受控標籤與別名；
    步驟、小提醒不標記；材料行內的用量與備註要明確 ignore（Pagefind 會把行內相鄰文字一起收進去）；圖片替代文字由 Illustration 的 data-pagefind-ignore="all" 排除。
    料理主角以篩選屬性 kind 提供，值與首頁網址的 kind 參數相同；每個值各用一個元素輸出，一道菜可帶多個值。
  -->
  <article
    class:list={[
      "recipe",
      { "print-dense": printDense, "has-print-sheet": hasPrintSheet },
    ]}
  >
    {
      hasPrintSheet && (
        <img
          class="print-sheet"
          src={`/prints/${id}.webp`}
          alt={data.title}
          data-pagefind-ignore="all"
        />
      )
    }
    {
      recipeKinds(data).map((kind) => (
        <span hidden data-pagefind-filter={`kind:${kind}`} />
      ))
    }
    <p class="print-mark">{SITE_NAME}</p>
    <header class="recipe-head">
      <h1 data-pagefind-body data-pagefind-weight="10">
        {data.title}{data.draft && <span>（草稿）</span>}
      </h1>
      <p class="summary" data-pagefind-body>{data.summary}</p>
      {
        searchTerms.length > 0 && (
          <p hidden data-pagefind-body>
            {searchTerms.join(" ")}
          </p>
        )
      }
      <p class="recipe-meta">
        <span>{data.servings} 人份</span>
        <span>{data.timeMinutes} 分鐘</span>
        <span>{recipeKindLabels(data).join("・")}</span>
      </p>
      <div class="recipe-actions">
        {
          hasPrintSheet && (
            <>
              <button
                type="button"
                class="print-recipe"
                aria-label="列印"
                title="列印"
              >
                <RecipeActionIcon name="print" />
                <span class="action-tooltip" aria-hidden="true">
                  列印
                </span>
              </button>
              <a
                href={`/prints/${id}.webp`}
                target="_blank"
                rel="noopener"
                aria-label="查看菜單圖片"
                title="查看菜單圖片"
              >
                <RecipeActionIcon name="preview" />
                <span class="action-tooltip" aria-hidden="true">
                  查看菜單圖片
                </span>
              </a>
              <a
                class="download-recipe-sheet"
                href={`/prints/${id}.webp`}
                download={`${id}.webp`}
                aria-label="下載圖片"
                title="下載圖片"
              >
                <RecipeActionIcon name="download" />
                <span class="action-tooltip" aria-hidden="true">
                  下載圖片
                </span>
              </a>
              <button
                type="button"
                class="share-recipe-sheet"
                aria-label="分享圖片"
                title="分享圖片"
                hidden
              >
                <RecipeActionIcon name="share" />
                <span class="action-tooltip" aria-hidden="true">
                  分享圖片
                </span>
              </button>
              <span class="recipe-sheet-status" role="status" />
            </>
          )
        }
        {
          !data.draft && (
            <div class="favorite-actions">
              <button
                type="button"
                data-favorite-id={id}
                aria-label="收藏這道菜"
                title="收藏這道菜"
                aria-pressed="false"
                hidden
              >
                <RecipeActionIcon name="bookmark" />
                <span class="action-tooltip" aria-hidden="true">
                  收藏這道菜
                </span>
              </button>
              <span data-favorite-state hidden />
              <p data-favorite-error role="alert" />
            </div>
          )
        }
      </div>
    </header>

    {
      data.hero && (
        <Illustration
          class="hero"
          image={data.hero}
          sizes={MAIN_SIZES}
          priority
        />
      )
    }

    <div class="recipe-body">
      <aside class="ingredients" aria-labelledby="ingredients-title">
        <h2 id="ingredients-title">材料</h2>
        {
          data.ingredientsPhoto && (
            <Illustration image={data.ingredientsPhoto} sizes={SIDE_SIZES} />
          )
        }
        {
          groups.map((group) => (
            <section>
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((ingredient) => (
                  <li>
                    <span>
                      <span data-pagefind-body>{ingredient.name}</span>{" "}
                      <span data-pagefind-ignore>
                        {formatAmount(ingredient.amount)}
                      </span>
                    </span>
                    {ingredient.note && (
                      <small data-pagefind-ignore>（{ingredient.note}）</small>
                    )}
                    {ingredient.image && (
                      <Illustration
                        class="ingredient-thumb"
                        image={ingredient.image}
                        sizes="6rem"
                      />
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </aside>

      <section class="method" aria-labelledby="method-title">
        <h2 id="method-title">做法</h2>
        <ol class="steps">
          {
            data.steps.map((step) => (
              <li>
                <p>{step.text}</p>
                {step.image && (
                  <Illustration image={step.image} sizes={STEP_SIZES} />
                )}
              </li>
            ))
          }
        </ol>
        {
          data.tip && (
            <section class="tip">
              <h2>小提醒</h2>
              <p>{data.tip}</p>
            </section>
          )
        }
      </section>
    </div>

    {
      relatedIngredients.length > 0 && (
        <section
          class="ingredient-guide"
          aria-labelledby="ingredient-guide-title"
        >
          <h2 id="ingredient-guide-title">了解食材</h2>
          <ul>
            {relatedIngredients.map((ingredient) => (
              <li>
                <a href={`/ingredients/${ingredient.id}/`}>
                  {ingredient.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      relatedTopics.length > 0 && (
        <section class="related-topics" aria-labelledby="related-topics-title">
          <h2 id="related-topics-title">相關專題</h2>
          <ul>
            {relatedTopics.map((topic) => (
              <li>
                <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
                <p>{topic.data.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      relatedRecipes.length > 0 && (
        <section
          class="related-recipes"
          aria-labelledby="related-recipes-title"
          data-pagefind-ignore
        >
          <h2 id="related-recipes-title">也可以試試</h2>
          <ul>
            {relatedRecipes.map((related) => (
              <li>
                <RecipeCard recipe={related} sizes={RELATED_SIZES} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <p class="print-foot">{SITE_NAME}</p>
  </article>
</Base>

<script>
  import { initRecipeFavorite } from "../../scripts/favorites";
  import { initRecipeSheet } from "../../scripts/recipe-sheet";

  initRecipeFavorite();
  initRecipeSheet();
  document.querySelector(".print-recipe")?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  .print-mark,
  .print-foot,
  .print-sheet {
    display: none;
  }
  .recipe-head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .recipe-head h1 {
    margin: 0 0 1rem;
    font-size: 2.25rem;
  }
  .summary {
    margin: 0 0 1rem;
  }
  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .recipe-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .favorite-actions button,
  .print-recipe,
  .share-recipe-sheet,
  .recipe-actions > a {
    min-width: 44px;
    min-height: 44px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .recipe-actions > a {
    text-decoration: none;
  }
  .recipe-actions .action-tooltip {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 1;
    width: max-content;
    margin: 0;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8rem;
    pointer-events: none;
    visibility: hidden;
  }
  .recipe-actions :focus-visible > .action-tooltip {
    visibility: visible;
  }
  @media (hover: hover) {
    .recipe-actions button:hover,
    .recipe-actions > a:hover {
      border-color: var(--ink);
      background: var(--line);
    }
    .recipe-actions :hover > .action-tooltip {
      visibility: visible;
    }
  }
  .recipe-actions button[hidden] {
    display: none;
  }
  .recipe-sheet-status {
    flex-basis: 100%;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .recipe-sheet-status:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .share-recipe-sheet:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .favorite-actions > span {
    margin-left: 0.75rem;
    color: var(--ink-soft);
  }
  .favorite-actions button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  .favorite-actions button[aria-pressed="true"] :global(svg) {
    fill: currentColor;
  }
  .favorite-actions button[hidden],
  .favorite-actions span[hidden],
  .favorite-actions p:empty {
    display: none;
  }
  .favorite-actions p {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  /* 以下 :global 選取 Illustration 元件內部的 figure */
  .recipe :global(.hero) {
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  .recipe-body {
    display: grid;
    gap: 3rem;
  }
  .ingredients h2,
  .method h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.25rem;
  }
  .ingredients h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
  }
  .ingredients ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ingredients li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ingredients li small {
    color: var(--ink-soft);
  }
  .ingredients :global(.ingredient-thumb) {
    width: 6rem;
    margin-top: 0.4rem;
  }
  .ingredients > :global(figure) {
    margin-bottom: 1rem;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps > li {
    position: relative;
    margin-bottom: 2.5rem;
    padding-left: 2.5rem;
    counter-increment: step;
  }
  .steps > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--ink-soft);
  }
  .steps > li p {
    margin: 0 0 0.75rem;
  }
  .tip {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .tip h2 {
    border-bottom: 0;
  }

  .ingredient-guide,
  .related-topics,
  .related-recipes {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .ingredient-guide h2,
  .related-topics h2,
  .related-recipes h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }
  .ingredient-guide ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ingredient-guide a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    text-underline-offset: 0.25em;
  }
  .related-topics ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related-topics li {
    margin-top: 0.75rem;
  }
  .related-topics a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 0.25em;
  }
  .related-topics p {
    margin: 0;
    color: var(--ink-soft);
  }
  .related-recipes ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .related-recipes ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* 寬螢幕：材料在左欄、捲動做法時保持可見（只 sticky，不設捲動區）；手機單欄 */
  @media (min-width: 64rem) {
    .recipe-body {
      grid-template-columns: 20rem minmax(0, 44rem);
      gap: 4rem;
      align-items: start;
    }
    .ingredients {
      position: sticky;
      top: 1.5rem;
    }
  }

  /* 列印對齊生圖那張：置中頁眉、菜名、成品圖，下方材料與做法對開 */
  @media print {
    .recipe {
      display: flex;
      flex-direction: column;
      min-height: 270mm;
    }
    .recipe.print-dense {
      min-height: 0;
      zoom: 0.9;
    }
    .recipe.print-dense :global(.hero) {
      width: 52mm;
      max-width: 52mm;
      margin: 2.5mm auto 1mm;
    }
    .recipe.print-dense .ingredients li {
      padding: 0.15mm 0;
      line-height: 1.28;
    }
    .recipe.print-dense .steps > li {
      margin-bottom: 1.2mm;
    }
    .ingredient-guide,
    .related-topics,
    .related-recipes,
    .recipe-actions,
    .ingredients :global(figure),
    .steps :global(figure) {
      display: none;
    }
    .print-mark,
    .print-foot {
      display: block;
      margin: 0;
      font-family: var(--font-serif);
      font-size: 11pt;
      letter-spacing: 0.28em;
      text-align: center;
    }
    .print-mark {
      margin-bottom: 2mm;
    }
    .print-foot {
      margin-top: auto;
      padding-top: 2.5mm;
      border-top: 0.6pt solid var(--ink);
      break-before: avoid;
    }
    .recipe-head {
      max-width: none;
      margin: 0;
      text-align: center;
    }
    .recipe-head h1 {
      margin: 0 0 2mm;
      font-size: 26pt;
      line-height: 1.15;
      letter-spacing: 0.08em;
    }
    .summary {
      max-width: none;
      margin: 0 0 2mm;
      font-size: 10.5pt;
      line-height: 1.5;
    }
    .recipe-meta {
      justify-content: center;
      gap: 0;
      margin: 0;
      padding: 0;
      border: 0;
      color: var(--ink-soft);
      font-size: 9.5pt;
      letter-spacing: 0.04em;
    }
    .recipe-meta span + span::before {
      content: "·";
      margin: 0 0.7em;
    }
    .recipe :global(.hero) {
      width: 72mm;
      max-width: 72mm;
      margin: 4mm auto 2mm;
    }
    .recipe-body {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-top: 4mm;
      padding-top: 0;
      border-top: 0;
      break-inside: auto;
    }
    .ingredients {
      position: static;
      padding-right: 6mm;
    }
    .method {
      padding-left: 6mm;
      border-left: 0.6pt solid var(--line);
    }
    .ingredients h2,
    .method h2 {
      margin: 0 0 2.5mm;
      padding-bottom: 1.2mm;
      border-bottom: 0.75pt solid var(--ink);
      font-size: 14pt;
      letter-spacing: 0.12em;
    }
    .ingredients h3 {
      margin: 1.6mm 0 0.4mm;
      color: var(--ink-soft);
      font-size: 9pt;
      font-weight: 600;
      letter-spacing: 0.08em;
    }
    .ingredients li {
      padding: 0.3mm 0;
      border-bottom: 0;
      line-height: 1.35;
      break-inside: avoid;
    }
    .ingredients li > span {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 3mm;
    }
    .ingredients li > span > span:last-child {
      flex: none;
      font-variant-numeric: tabular-nums;
