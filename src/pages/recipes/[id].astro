---
import Base from "../../layouts/Base.astro";
import Illustration from "../../components/Illustration.astro";
import { formatAmount, groupIngredients } from "../../utils/ingredients";
import { getVisibleRecipes } from "../../utils/recipes";
import type { Recipe } from "../../utils/recipes";

export async function getStaticPaths() {
  const recipes = await getVisibleRecipes();
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

interface Props {
  recipe: Recipe;
}
const { data } = Astro.props.recipe;
const groups = groupIngredients(data.ingredients);

// sizes 對應下方 CSS：寬螢幕主欄與成品圖上限 44rem，手機單欄約等於視窗寬。
const MAIN_SIZES = "(min-width: 64rem) 44rem, 100vw";
const SIDE_SIZES = "(min-width: 64rem) 20rem, 100vw";
---

<Base title={`${data.title}｜CarlKitchen`}>
  <article class="recipe">
    <header class="recipe-head">
      <h1>{data.title}{data.draft && <span>（草稿）</span>}</h1>
      <p class="summary">{data.summary}</p>
      <p class="recipe-meta">
        <span>{data.servings} 人份</span>
        {data.timeMinutes && <span>{data.timeMinutes} 分鐘</span>}
        <span>{data.category}</span>
      </p>
    </header>

    {
      data.hero && (
        <Illustration
          class="hero"
          image={data.hero}
          sizes={MAIN_SIZES}
          priority
        />
      )
    }

    <div class="recipe-body">
      <aside class="ingredients" aria-labelledby="ingredients-title">
        <h2 id="ingredients-title">材料</h2>
        {
          data.ingredientsPhoto && (
            <Illustration image={data.ingredientsPhoto} sizes={SIDE_SIZES} />
          )
        }
        {
          groups.map((group) => (
            <section>
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((ingredient) => (
                  <li>
                    <span>
                      {ingredient.name} {formatAmount(ingredient.amount)}
                    </span>
                    {ingredient.note && <small>（{ingredient.note}）</small>}
                    {ingredient.image && (
                      <Illustration
                        class="ingredient-thumb"
                        image={ingredient.image}
                        sizes="6rem"
                      />
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </aside>

      <section class="method" aria-labelledby="method-title">
        <h2 id="method-title">做法</h2>
        <ol class="steps">
          {
            data.steps.map((step) => (
              <li>
                <p>{step.text}</p>
                {step.image && (
                  <Illustration image={step.image} sizes={MAIN_SIZES} />
                )}
              </li>
            ))
          }
        </ol>
        {
          data.tip && (
            <section class="tip">
              <h2>小提醒</h2>
              <p>{data.tip}</p>
            </section>
          )
        }
      </section>
    </div>

    <section class="disclaimer" aria-label="聲明">
      <p>依公開資料由 AI 整理、站主審閱，未經試做</p>
    </section>
  </article>
</Base>

<style>
  .recipe-head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .recipe-head h1 {
    margin: 0 0 1rem;
    font-size: 2.25rem;
  }
  .summary {
    margin: 0 0 1rem;
  }
  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  /* 以下 :global 選取 Illustration 元件內部的 figure */
  .recipe :global(.hero) {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .recipe-body {
    display: grid;
    gap: 3rem;
  }
  .ingredients h2,
  .method h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.25rem;
  }
  .ingredients h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
  }
  .ingredients ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ingredients li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ingredients li small {
    color: var(--ink-soft);
  }
  .ingredients :global(.ingredient-thumb) {
    width: 6rem;
    margin-top: 0.4rem;
  }
  .ingredients > :global(figure) {
    margin-bottom: 1rem;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps > li {
    position: relative;
    margin-bottom: 2.5rem;
    padding-left: 2.5rem;
    counter-increment: step;
  }
  .steps > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--ink-soft);
  }
  .steps > li p {
    margin: 0 0 0.75rem;
  }
  .tip {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .tip h2 {
    border-bottom: 0;
  }

  .disclaimer {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .disclaimer p {
    margin: 0;
  }

  /* 寬螢幕：材料在左欄、捲動做法時保持可見（只 sticky，不設捲動區）；手機單欄 */
  @media (min-width: 64rem) {
    .recipe-body {
      grid-template-columns: 20rem minmax(0, 44rem);
      gap: 4rem;
      align-items: start;
    }
    .ingredients {
      position: sticky;
      top: 1.5rem;
    }
  }

  /* 列印：只留成品圖、材料與做法；步驟圖與材料合照不印，確保一張紙 */
  @media print {
    .disclaimer,
    .ingredients :global(figure),
    .steps :global(figure) {
      display: none;
    }
    .recipe :global(.hero) {
      max-width: 14rem;
      margin-bottom: 1rem;
    }
    .recipe-body {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
    .steps > li {
      break-inside: avoid;
    }
  }
</style>
