---
import Base from "../layouts/Base.astro";
import Illustration from "../components/Illustration.astro";
import { getVisibleRecipes, recipeHref } from "../utils/recipes";

const recipes = (await getVisibleRecipes()).filter(
  (recipe) => !recipe.data.draft,
);
---

<Base title="我的收藏">
  <section class="favorites" aria-labelledby="favorites-title">
    <h1 id="favorites-title">我的收藏</h1>
    <p>收藏只保存在這個瀏覽器；換裝置或清除網站資料後不會保留。</p>
    <noscript><p>需要啟用 JavaScript 才能查看本機收藏。</p></noscript>
    <p data-favorites-status role="status" hidden></p>
    <ul data-favorites-list hidden>
      {
        recipes.map((recipe) => (
          <li data-favorite-row={recipe.id} hidden>
            {recipe.data.hero && (
              <Illustration
                image={recipe.data.hero}
                sizes="(min-width: 40rem) 120px, 72px"
                widths={[144, 240, 360]}
              />
            )}
            <div>
              <h2>
                <a href={recipeHref(recipe)}>{recipe.data.title}</a>
              </h2>
              <p>{recipe.data.summary}</p>
            </div>
            <button
              type="button"
              data-remove-id={recipe.id}
              aria-label={`移除收藏：${recipe.data.title}`}
            >
              移除
            </button>
          </li>
        ))
      }
    </ul>
    <a class="browse-link" href="/#recipes">瀏覽菜譜</a>
  </section>
</Base>

<script>
  import { initFavoritesPage } from "../scripts/favorites";

  initFavoritesPage();
</script>

<style>
  .favorites h1 {
    margin: 0 0 1rem;
    font-size: 2.25rem;
  }
  .favorites > p {
    color: var(--ink-soft);
  }
  .favorites ul {
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }
  .favorites li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .favorites li[hidden] {
    display: none;
  }
  .favorites li :global(figure) {
    grid-row: 1 / 3;
  }
  .favorites h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .favorites li p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .favorites button,
  .browse-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.35rem 1rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .favorites button {
    grid-column: 2;
    justify-self: start;
  }
  .browse-link {
    text-decoration: none;
  }
  @media (min-width: 40rem) {
    .favorites li {
      grid-template-columns: 120px minmax(0, 1fr) auto;
      gap: 1.5rem;
    }
    .favorites li :global(figure) {
      grid-row: 1;
    }
    .favorites button {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
