---
import Base from "../layouts/Base.astro";
import Illustration from "../components/Illustration.astro";
import HomeSeason from "../components/HomeSeason.astro";
import {
  parseBatchSize,
  recipeKinds,
  recipeKindLabels,
  visibleKindOptions,
} from "../utils/home";
import { SITE_NAME, SITE_TAGLINE } from "../utils/site";
import { getVisibleRecipes, recipeHref } from "../utils/recipes";
import { getVisibleTopicEntries } from "../utils/topic-entries";

const recipes = await getVisibleRecipes();
const topics = await getVisibleTopicEntries();
// 草稿（開發模式才會出現）可能沒有成品圖，不參與大圖。
const heroRecipes = recipes.filter((recipe) => recipe.data.hero);

// 解析到大圖區就同步挑圖並插入（腳本緊接在 template 之後），首次繪製前版面已定、不會位移。
// 每次開啟隨機；網址帶分類時從該類挑，免得腳本載入後再換圖。
// template 內容不會載入，只有選中的那張下載。內容是 JS，不能含 TS 語法。
const HERO_PICK_SCRIPT = `(() => {
  const section = document.currentScript?.parentElement;
  const slots = [...(section?.getElementsByTagName("template") ?? [])];
  const kind = new URLSearchParams(location.search).get("kind");
  const matching = slots.filter((slot) =>
    slot.content.firstElementChild?.dataset.kinds?.split(" ").includes(kind),
  );
  const pool = matching.length > 0 ? matching : slots;
  const pick = pool[Math.floor(Math.random() * pool.length)];
  if (section && pick) section.append(pick.content.cloneNode(true));
})();`;

// 每批顯示列數：建置時決定、寫進按鈕的 data-batch 供腳本讀取；唯一定義處是 parseBatchSize。
const batchSize = parseBatchSize(process.env.HOME_BATCH_SIZE);

// 手機版大圖（< 40rem）佔內容寬的比例，只在這裡定義：CSS 以 --hero-image-width 取用，sizes 由它算出。
// 插畫是 3:2，佔一半寬時框高是內容寬 ÷ 3；調整依 pnpm measure:mobile 的第一列底端。
const HERO_MOBILE_WIDTH_RATIO = 0.5;
// sizes 照實際顯示寬度寫：寬螢幕 36rem、平板整個內容寬、手機依上面的比例。
const HERO_SIZES = `(min-width: 64rem) 36rem, (min-width: 40rem) calc(100vw - 3rem), calc((100vw - 3rem) * ${HERO_MOBILE_WIDTH_RATIO})`;

const filters = visibleKindOptions(recipes.map((recipe) => recipe.data));
---

<Base
  description="煮奔提供站主審閱的繁體中文家常菜譜，從菜名、材料或分類找到今天想煮的料理。"
>
  <div
    class="home"
    data-intro
    data-has-hero={heroRecipes.length > 0 ? "" : undefined}
  >
    <div class="intro-text">
      <p class="today" data-today></p>
      <div class="masthead">
        <h1>{SITE_NAME}</h1>
        <p class="tagline">{SITE_TAGLINE}</p>
      </div>
      <form class="search" role="search" data-search-form>
        <label for="search-input">搜尋菜譜</label>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="菜名、材料或標籤"
          autocomplete="off"
        />
        <!-- 全頁唯一會朗讀的區域；清單區只放一般文字，避免筆數被讀兩次。 -->
        <p
          id="search-status"
          class="search-status"
          role="status"
          set:text={`共 ${recipes.length} 道`}
        />
      </form>
      <a class="meal-link" href="/meal/">配一桌四菜一湯</a>
      <HomeSeason topics={topics} />
    </div>

    {
      recipes.length > 0 && (
        <div class="list-tools mobile-list-tools">
          <div class="filters" role="group" aria-label="篩選">
            {filters.map((filter) => (
              <button
                type="button"
                data-filter={filter.value}
                aria-pressed={filter.value === "all" ? "true" : "false"}
              >
                {filter.label}
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      heroRecipes.length > 0 && (
        <section
          class="hero-pick"
          aria-label="隨機看看一道菜"
          style={`--hero-image-width: ${HERO_MOBILE_WIDTH_RATIO * 100}%`}
        >
          {heroRecipes.map((recipe) => (
            <template data-hero-slot>
              <a
                href={recipeHref(recipe)}
                data-kinds={recipeKinds(recipe.data).join(" ")}
              >
                <p class="hero-label" aria-hidden="true">
                  隨機看看一道菜
                </p>
                <Illustration
                  image={recipe.data.hero!}
                  sizes={HERO_SIZES}
                  priority
                />
                <p class="hero-title">{recipe.data.title}</p>
              </a>
            </template>
          ))}
          <noscript>
            <a href={recipeHref(heroRecipes[0]!)}>
              <p class="hero-label" aria-hidden="true">
                隨機看看一道菜
              </p>
              <Illustration
                image={heroRecipes[0]!.data.hero!}
                sizes={HERO_SIZES}
                priority
              />
              <p class="hero-title">{heroRecipes[0]!.data.title}</p>
            </a>
          </noscript>
          <script is:inline set:html={HERO_PICK_SCRIPT} />
        </section>
      )
    }
    <section id="recipes" class="recipe-list" aria-labelledby="recipes-title">
      <h2 id="recipes-title">菜譜清單</h2>
      {
        recipes.length === 0 ? (
          <p>目前還沒有菜譜。</p>
        ) : (
          <>
            <div class="list-tools desktop-list-tools">
              <div class="filters" role="group" aria-label="篩選">
                {filters.map((filter) => (
                  <button
                    type="button"
                    data-filter={filter.value}
                    aria-pressed={filter.value === "all" ? "true" : "false"}
                  >
                    {filter.label}
                  </button>
                ))}
              </div>
            </div>
            <ul class="rows">
              {recipes.map((recipe) => (
                <li
                  class="row"
                  data-recipe-row
                  data-recipe-id={recipe.id}
                  data-kinds={recipeKinds(recipe.data).join(" ")}
                >
                  {recipe.data.hero && (
                    <Illustration
                      class="thumb"
                      image={recipe.data.hero}
                      sizes="(min-width: 40rem) 120px, 72px"
                      widths={[144, 240, 360]}
                    />
                  )}
                  <h3>
                    <a href={recipeHref(recipe)}>{recipe.data.title}</a>
                    {recipe.data.draft && <span>（草稿）</span>}
                  </h3>
                  <p class="row-summary">{recipe.data.summary}</p>
                  <span class="kind">
                    {recipeKindLabels(recipe.data).join("・")}
                  </span>
                </li>
              ))}
              {
                // 專題只在有搜尋字詞且命中時由腳本顯示；沒有字詞或套用分類篩選時不出現。
                topics.map((topic) => (
                  <li
                    class="row"
                    data-topic-row
                    data-topic-id={topic.id}
                    hidden
                  >
                    <h3>
                      <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
                      {topic.data.draft && <span>（草稿）</span>}
                    </h3>
                    <p class="row-summary">{topic.data.summary}</p>
                    <span class="kind">專題</span>
                  </li>
                ))
              }
            </ul>
            {
              // 漸進增強：建置輸出全部列可見、按鈕隱藏；腳本初始化後才收起超出的列並顯示按鈕。
            }
            <button
              type="button"
              class="show-more"
              data-show-more
              data-batch={batchSize}
              hidden
            >
              顯示更多
            </button>
            <div class="empty" data-empty hidden>
              <p data-empty-message />
              <button type="button" data-clear>
                清除條件
              </button>
            </div>
          </>
        )
      }
    </section>
  </div>
</Base>

<script>
  import { initHome } from "../scripts/home";

  initHome();
</script>

<style>
  .today {
    margin: 0 0 0.5rem;
    min-height: 1.8em;
    color: var(--ink-soft);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }
  /* 站名與標語組成直排題字：依直排由右往左的讀序，站名在右、標語在左。 */
  .masthead {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 1.25rem;
    margin: 0 0 2rem;
  }
  .masthead .tagline {
    margin: 0.4em 0 0;
    writing-mode: vertical-rl;
    /* 一欄七字，在「飯」後換欄 */
    inline-size: 8.1em;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.8;
    letter-spacing: 0.15em;
  }
  .intro-text h1 {
    margin: 0;
    writing-mode: vertical-rl;
    font-size: 3rem;
    line-height: 1.1;
    letter-spacing: 0.1em;
  }
  @media (min-width: 64rem) {
    .intro-text h1 {
      font-size: 4.5rem;
    }
  }
  .search label {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .search input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .search-status {
    margin: 0.5rem 0 0;
    min-height: 1.8em;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .meal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    text-decoration: none;
  }
  .hero-pick {
    position: relative;
  }
  .hero-pick a {
    display: block;
    text-decoration: none;
  }
  .hero-pick {
    margin-top: 2rem;
  }
  .hero-label {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    margin: 0;
    padding: 0.1rem 0.5rem;
    background: var(--paper);
    color: var(--ink-soft);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    pointer-events: none;
  }
  .hero-title {
    margin: 0.25rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .recipe-list {
    margin-top: 4rem;
    scroll-margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .recipe-list h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }
  .list-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .mobile-list-tools {
    display: none;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .filters button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }
  .empty {
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .empty p {
    margin: 0 0 1rem;
  }
  .empty button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .show-more {
    width: 100%;
    min-height: 44px;
    margin: 1.5rem 0;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    /* 首屏外的列延後排版與繪製，縮短首次算繪的長任務。預估高度只算內容區：手機列高 142px（pnpm measure:mobile）扣上下 padding 與上框線；算繪過後改記實際高度。 */
    content-visibility: auto;
    contain-intrinsic-size: auto 101px;
  }
  .row[hidden] {
    display: none;
  }
  .row :global(.thumb) {
    grid-column: 1;
    grid-row: 1 / 4;
  }
  .row h3,
  .row .row-summary,
  .row .kind {
    grid-column: 2;
  }
  .row h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  /* 連結撐滿整列，整列可點，但可聚焦與朗讀的仍只有菜名 */
  .row h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .row h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .row h3 a:focus-visible {
    outline: none;
  }
  .row h3 a:focus-visible::after {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .row-summary {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .kind {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 120px minmax(0, 1fr) auto;
      column-gap: 1.75rem;
      align-items: center;
      /* 寬版列內容至少是縮圖高 80px（摘要一行時列高 121px）；摘要換行的列較高，捲到時才修正。 */
      contain-intrinsic-size: auto 80px;
    }
    .row :global(.thumb) {
      grid-row: 1 / 3;
    }
    .row .kind {
      grid-column: 3;
      grid-row: 1 / 3;
      margin-top: 0;
    }
  }

  /* 手機版以整個首頁作為固定篩選列的範圍，讓篩選列捲過大圖後仍留在清單上方。 */
  @media (max-width: 39.99rem) {
    :global(main) {
      padding-top: 1.5rem;
    }
    /* 直排大字在手機縮小，讓第一道菜仍落在第一屏內 */
    .masthead {
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .intro-text h1 {
      font-size: 2rem;
    }
    .masthead .tagline {
      font-size: 0.8rem;
    }
    .meal-link,
    .desktop-list-tools {
      display: none;
    }
    .mobile-list-tools {
      display: flex;
      position: sticky;
      top: 0;
      z-index: 1;
      margin: 0.75rem 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .hero-pick {
      margin-top: 0;
    }
    /* 圖左、文字右：右欄上方小字標籤、下方菜名；整塊仍是同一個連結 */
    .hero-pick a {
      display: grid;
      grid-template-columns: var(--hero-image-width) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 1rem;
      align-items: start;
    }
    /* 成品大圖由腳本複製進來，圖本身是子元件、沒有本頁的範圍屬性，所以用 :global */
    .hero-pick a > :global(figure.illustration) {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    /* 標籤不再疊在圖上，成為右欄上方的小字 */
    .hero-label {
      position: static;
      grid-column: 2;
      grid-row: 1;
      padding: 0;
      background: none;
    }
    .hero-title {
      grid-column: 2;
      grid-row: 2;
    }
    /* 標題只在視覺上隱藏，仍在 DOM 與標題階層，區塊的 aria-labelledby 不變 */
    .recipe-list h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .recipe-list {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      scroll-margin-top: 6rem;
      /* 標題隱藏後區塊頂線會緊貼第一列的上框線，只留列的那一條 */
      border-top: none;
    }
    /* 截成 1 行；完整文字仍在 DOM，供螢幕閱讀器與 Pagefind 讀取 */
    .row-summary {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      overflow: hidden;
    }
  }

  /* 有搜尋字詞時收起隨機大圖；窄螢幕大圖疊在清單上方，篩選時也收起，讓清單緊接篩選列。 */
  .home[data-has-query] .hero-pick {
    display: none;
  }
  @media (max-width: 63.99rem) {
    .home[data-has-criteria] .hero-pick {
      display: none;
    }
  }

  /* 寬螢幕第一屏：左文右圖；篩選時大圖由腳本換成該類的菜，搜尋時收起圖片欄。 */
  @media (min-width: 64rem) {
    .home[data-has-hero]:not([data-has-query]) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 36rem;
      column-gap: 4rem;
    }
    .intro-text {
      align-self: center;
    }
    .hero-pick {
      margin-top: 0;
    }
    .recipe-list {
      grid-column: 1 / -1;
    }
  }
</style>
