---
import Base from "../layouts/Base.astro";
import Illustration from "../components/Illustration.astro";
import { recipeKinds, visibleKindOptions } from "../utils/home";
import { SITE_NAME, SITE_TAGLINE } from "../utils/site";
import { getVisibleRecipes, recipeHref } from "../utils/recipes";
import { getVisibleTopicEntries } from "../utils/topic-entries";
import solarTermsData from "../prototypes/solar-terms-data.json";

// Prototype question: where does a small 24-solar-term reference fit on the homepage?
// Three throwaway layouts are available in development through ?variant=a|b|c.
const isPrototype = import.meta.env.DEV;
const termArt: Record<string, string> = {
  小寒: "xiaohan",
  大寒: "dahan",
  立春: "lichun",
  雨水: "yushui",
  驚蟄: "jingzhe",
  春分: "chunfen",
  清明: "qingming",
  穀雨: "guyu",
  立夏: "lixia",
  小滿: "xiaoman",
  芒種: "mangzhong",
  夏至: "xiazhi",
  小暑: "xiaoshu",
  大暑: "dashu",
  立秋: "liqiu",
  處暑: "chushu",
  白露: "bailu",
  秋分: "qiufen",
  寒露: "hanlu",
  霜降: "shuangjiang",
  立冬: "lidong",
  小雪: "xiaoxue",
  大雪: "daxue",
  冬至: "dongzhi",
};
const terms = solarTermsData.terms.map((term) => ({
  ...term,
  at: new Date(`${term.date}T${term.time}:00+08:00`),
}));
const nextTerm =
  terms.find((term) => term.at.getTime() >= Date.now()) ?? terms[0]!;
const upcomingTerms = terms
  .filter((term) => term.at >= nextTerm.at)
  .slice(0, 4);
const termDateLabel = (term: (typeof terms)[number]) => {
  const [, month, day] = term.date.split("-").map(Number);
  return `${month} 月 ${day} 日`;
};

const recipes = await getVisibleRecipes();
const topics = await getVisibleTopicEntries();
// 草稿（開發模式才會出現）可能沒有成品圖，不參與大圖。
const heroRecipes = recipes.filter((recipe) => recipe.data.hero);

// 解析到大圖區就同步挑圖並插入（腳本緊接在 template 之後），首次繪製前版面已定、不會位移。
// 每次開啟隨機；網址帶分類時從該類挑，免得腳本載入後再換圖。
// template 內容不會載入，只有選中的那張下載。內容是 JS，不能含 TS 語法。
const HERO_PICK_SCRIPT = `(() => {
  const section = document.currentScript?.parentElement;
  const slots = [...(section?.getElementsByTagName("template") ?? [])];
  const kind = new URLSearchParams(location.search).get("kind");
  const matching = slots.filter((slot) =>
    slot.content.firstElementChild?.dataset.kinds?.split(" ").includes(kind),
  );
  const pool = matching.length > 0 ? matching : slots;
  const pick = pool[Math.floor(Math.random() * pool.length)];
  if (section && pick) section.append(pick.content.cloneNode(true));
})();`;

const filters = visibleKindOptions(recipes.map((recipe) => recipe.data));
---

<Base
  description="煮奔提供站主審閱的繁體中文家常菜譜，從菜名、材料或分類找到今天想煮的料理。"
>
  <div
    class="home"
    data-intro
    data-has-hero={heroRecipes.length > 0 ? "" : undefined}
  >
    <div class="intro-text">
      <p class="today" data-today></p>
      <div class="masthead">
        <h1>{SITE_NAME}</h1>
        <p class="tagline">{SITE_TAGLINE}</p>
      </div>
      <form class="search" role="search" data-search-form>
        <label for="search-input">搜尋菜譜</label>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="菜名、材料或標籤"
          autocomplete="off"
        />
        <!-- 全頁唯一會朗讀的區域；清單區只放一般文字，避免筆數被讀兩次。 -->
        <p
          id="search-status"
          class="search-status"
          role="status"
          set:text={`共 ${recipes.length} 道`}
        />
      </form>
      <a class="meal-link" href="/meal/">配一桌四菜一湯</a>
      {
        isPrototype && (
          <section
            class="term-note term-note-a"
            data-term-variant="a"
            hidden
            aria-label="二十四節氣"
          >
            <img
              class="term-note-illustration"
              src={`/solar-terms/${termArt[nextTerm.name]}.webp`}
              alt={`${nextTerm.name}節氣插畫`}
              width="1536"
              height="1024"
            />
            <span class="term-kicker">下一個節氣</span>
            <strong>{nextTerm.name}</strong>
            <span>
              {termDateLabel(nextTerm)}　{nextTerm.time}
            </span>
            <small>資料：中央氣象署</small>
          </section>
        )
      }
    </div>

    {
      isPrototype && (
        <section
          class="term-note term-note-b"
          data-term-variant="b"
          hidden
          aria-labelledby="term-title-b"
        >
          <p class="term-kicker">二十四節氣・{nextTerm.at.getFullYear()}</p>
          <h2 id="term-title-b">{nextTerm.name}</h2>
          <p class="term-date">
            {termDateLabel(nextTerm)} <span>{nextTerm.time}</span>
          </p>
          <p class="term-caption">太陽行經黃道的節氣時刻</p>
          <p class="term-source">日期與時間｜中央氣象署</p>
        </section>
      )
    }

    {
      recipes.length > 0 && (
        <div class="list-tools mobile-list-tools">
          <div class="filters" role="group" aria-label="篩選">
            {filters.map((filter) => (
              <button
                type="button"
                data-filter={filter.value}
                aria-pressed={filter.value === "all" ? "true" : "false"}
              >
                {filter.label}
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      heroRecipes.length > 0 && (
        <section class="hero-pick" aria-label="隨機看看一道菜">
          <p class="hero-label">隨機看看一道菜</p>
          {heroRecipes.map((recipe) => (
            <template data-hero-slot>
              <a
                href={recipeHref(recipe)}
                data-kinds={recipeKinds(recipe.data).join(" ")}
              >
                <Illustration
                  image={recipe.data.hero!}
                  sizes="(min-width: 64rem) 36rem, 100vw"
                  priority
                />
                <p class="hero-title">{recipe.data.title}</p>
              </a>
            </template>
          ))}
          <noscript>
            <a href={recipeHref(heroRecipes[0]!)}>
              <Illustration
                image={heroRecipes[0]!.data.hero!}
                sizes="(min-width: 64rem) 36rem, 100vw"
                priority
              />
              <p class="hero-title">{heroRecipes[0]!.data.title}</p>
            </a>
          </noscript>
          <script is:inline set:html={HERO_PICK_SCRIPT} />
        </section>
      )
    }
    <section id="recipes" class="recipe-list" aria-labelledby="recipes-title">
      {
        isPrototype && (
          <section
            class="term-note term-note-c"
            data-term-variant="c"
            hidden
            aria-labelledby="term-title-c"
          >
            <div class="term-heading">
              <div>
                <p class="term-kicker">一年二十四節氣</p>
                <h2 id="term-title-c">接下來的時令</h2>
              </div>
              <small>中央氣象署資料</small>
            </div>
            <ol>
              {upcomingTerms.map((term, index) => (
                <li class={index === 0 ? "list-active" : undefined}>
                  <span>{term.name}</span>
                  <time datetime={`${term.date}T${term.time}:00+08:00`}>
                    {termDateLabel(term)}　{term.time}
                  </time>
                </li>
              ))}
            </ol>
            <p class="term-caption">節氣時間為臺灣時間（UTC+8）</p>
          </section>
        )
      }
      <h2 id="recipes-title">菜譜清單</h2>
      {
        recipes.length === 0 ? (
          <p>目前還沒有菜譜。</p>
        ) : (
          <>
            <div class="list-tools desktop-list-tools">
              <div class="filters" role="group" aria-label="篩選">
                {filters.map((filter) => (
                  <button
                    type="button"
                    data-filter={filter.value}
                    aria-pressed={filter.value === "all" ? "true" : "false"}
                  >
                    {filter.label}
                  </button>
                ))}
              </div>
            </div>
            <ul class="rows">
              {recipes.map((recipe) => (
                <li
                  class="row"
                  data-recipe-row
                  data-recipe-id={recipe.id}
                  data-kinds={recipeKinds(recipe.data).join(" ")}
                >
                  {recipe.data.hero && (
                    <Illustration
                      class="thumb"
                      image={recipe.data.hero}
                      sizes="(min-width: 40rem) 120px, 72px"
                      widths={[144, 240, 360]}
                    />
                  )}
                  <h3>
                    <a href={recipeHref(recipe)}>{recipe.data.title}</a>
                    {recipe.data.draft && <span>（草稿）</span>}
                  </h3>
                  <p class="row-summary">{recipe.data.summary}</p>
                  <span class="kind">{recipe.data.category}</span>
                </li>
              ))}
              {
                // 專題只在有搜尋字詞且命中時由腳本顯示；沒有字詞或套用分類篩選時不出現。
                topics.map((topic) => (
                  <li
                    class="row"
                    data-topic-row
                    data-topic-id={topic.id}
                    hidden
                  >
                    <h3>
                      <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
                      {topic.data.draft && <span>（草稿）</span>}
                    </h3>
                    <p class="row-summary">{topic.data.summary}</p>
                    <span class="kind">專題</span>
                  </li>
                ))
              }
            </ul>
            <div class="empty" data-empty hidden>
              <p data-empty-message />
              <button type="button" data-clear>
                清除條件
              </button>
            </div>
          </>
        )
      }
    </section>
  </div>
</Base>

<script>
  import { initHome } from "../scripts/home";

  initHome();

  if (document.querySelector(".prototype-switcher")) {
    const variants = ["a", "b", "c"];
    const labels: Record<string, string> = {
      a: "日期旁簡註",
      b: "編輯式節氣卡",
      c: "近期節氣列表",
    };
    const requested = new URL(location.href).searchParams.get("variant");
    const active = variants.includes(requested ?? "") ? requested! : "a";
    document
      .querySelectorAll<HTMLElement>("[data-term-variant]")
      .forEach((section) => {
        section.hidden = section.dataset.termVariant !== active;
      });
    document
      .querySelector("[data-intro]")
      ?.setAttribute("data-prototype-variant", active);
    const switcher = document.querySelector<HTMLElement>(".prototype-switcher");
    const label = switcher?.querySelector("[data-variant-label]");
    if (label)
      label.textContent = `版面原型 ${active.toUpperCase()} · ${labels[active]}`;
    const index = variants.indexOf(active);
    const previous = switcher?.querySelector<HTMLAnchorElement>(
      "[data-variant-prev]",
    );
    const next = switcher?.querySelector<HTMLAnchorElement>(
      "[data-variant-next]",
    );
    if (previous) previous.href = `/?variant=${variants[(index + 2) % 3]}`;
    if (next) next.href = `/?variant=${variants[(index + 1) % 3]}`;

    document.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (
        event.target instanceof HTMLElement &&
        event.target.closest(
          "input, textarea, select, [contenteditable='true']",
        )
      )
        return;
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const current = new URL(location.href).searchParams.get("variant") || "a";
      const index = variants.indexOf(current);
      const offset = event.key === "ArrowRight" ? 1 : -1;
      location.href = `/?variant=${variants[(index + offset + variants.length) % variants.length]}`;
    });
  }
</script>

{
  isPrototype && (
    <nav class="prototype-switcher" aria-label="節氣版面原型切換">
      <a href="/?variant=c" data-variant-prev aria-label="上一個原型">
        ←
      </a>
      <span data-variant-label>版面原型 A · 日期旁簡註</span>
      <a href="/?variant=b" data-variant-next aria-label="下一個原型">
        →
      </a>
    </nav>
  )
}

<style>
  .today {
    margin: 0 0 0.5rem;
    min-height: 1.8em;
    color: var(--ink-soft);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }
  /* 站名與標語組成直排題字：依直排由右往左的讀序，站名在右、標語在左。 */
  .masthead {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 1.25rem;
    margin: 0 0 2rem;
  }
  .masthead .tagline {
    margin: 0.4em 0 0;
    writing-mode: vertical-rl;
    /* 一欄七字，在「飯」後換欄 */
    inline-size: 8.1em;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.8;
    letter-spacing: 0.15em;
  }
  .intro-text h1 {
    margin: 0;
    writing-mode: vertical-rl;
    font-size: 3rem;
    line-height: 1.1;
    letter-spacing: 0.1em;
  }
  @media (min-width: 64rem) {
    .intro-text h1 {
      font-size: 4.5rem;
    }
  }
  .search label {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .search input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .search-status {
    margin: 0.5rem 0 0;
    min-height: 1.8em;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .meal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    text-decoration: none;
  }
  .term-note {
    color: var(--ink);
  }
  .term-note[hidden] {
    display: none;
  }
  .term-kicker {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
  }
  .term-note-a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .term-note-illustration {
    grid-column: 1;
    grid-row: 1 / 5;
    display: block;
    width: 5rem;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .term-note-a .term-kicker,
  .term-note-a strong,
  .term-note-a > span:last-of-type,
  .term-note-a small {
    grid-column: 2;
  }
  .term-note-a strong {
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }
  .term-note-a > span:last-of-type {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .term-note-a small {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
  .term-note-b {
    align-self: center;
    padding: 2rem 2.25rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    text-align: center;
  }
  .term-note-b h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 0.16em;
  }
  .term-date {
    margin: 0.25rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }
  .term-date span {
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  .term-caption,
  .term-source {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  .term-source {
    margin-top: 1.25rem;
  }
  .term-note-c {
    margin: 0 0 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .term-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }
  .term-heading h2 {
    margin: 0.25rem 0 0;
    font-size: 1.5rem;
  }
  .term-heading small {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
  .term-note-c ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .term-note-c li {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem;
    border-left: 1px solid var(--line);
  }
  .term-note-c li:first-child {
    border-left: 2px solid var(--ink);
  }
  .term-note-c li span {
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }
  .term-note-c li time {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
  .term-note-c li.list-active span {
    font-weight: 700;
  }
  .term-note-c > .term-caption {
    text-align: right;
  }
  .prototype-switcher {
    position: fixed;
    z-index: 5;
    right: 50%;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(50%);
    padding: 0.35rem 0.6rem;
    border: 1px solid #444;
    border-radius: 999px;
    background: #333;
    color: white;
    box-shadow: 0 2px 12px #0003;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .prototype-switcher a {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: inherit;
    text-decoration: none;
  }
  .prototype-switcher a:hover {
    background: #ffffff24;
  }
  .hero-pick {
    position: relative;
  }
  .hero-pick a {
    display: block;
    text-decoration: none;
  }
  .hero-pick {
    margin-top: 2rem;
  }
  .hero-label {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    margin: 0;
    padding: 0.1rem 0.5rem;
    background: var(--paper);
    color: var(--ink-soft);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    pointer-events: none;
  }
  .hero-title {
    margin: 0.25rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .recipe-list {
    margin-top: 4rem;
    scroll-margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .recipe-list h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }
  .list-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .mobile-list-tools {
    display: none;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .filters button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }
  .empty {
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .empty p {
    margin: 0 0 1rem;
  }
  .empty button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .row[hidden] {
    display: none;
  }
  .row :global(.thumb) {
    grid-column: 1;
    grid-row: 1 / 4;
  }
  .row h3,
  .row .row-summary,
  .row .kind {
    grid-column: 2;
  }
  .row h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  /* 連結撐滿整列，整列可點，但可聚焦與朗讀的仍只有菜名 */
  .row h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .row h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .row h3 a:focus-visible {
    outline: none;
  }
  .row h3 a:focus-visible::after {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .row-summary {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .kind {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
