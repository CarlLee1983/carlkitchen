---
import Base from "../layouts/Base.astro";
import Illustration from "../components/Illustration.astro";
import { recipeKinds, visibleKindOptions } from "../utils/home";
import { SITE_NAME } from "../utils/site";
import { getVisibleRecipes, recipeHref } from "../utils/recipes";

const recipes = await getVisibleRecipes();
// 草稿（開發模式才會出現）可能沒有成品圖，不參與大圖。
const heroRecipes = recipes.filter((recipe) => recipe.data.hero);

// 解析到大圖區就同步挑圖並插入（腳本緊接在 template 之後），首次繪製前版面已定、不會位移。
// 每次開啟隨機；template 內容不會載入，只有選中的那張下載。內容是 JS，不能含 TS 語法。
const HERO_PICK_SCRIPT = `(() => {
  const section = document.currentScript?.parentElement;
  const slots = section?.getElementsByTagName("template");
  const pick = slots?.[Math.floor(Math.random() * slots.length)];
  if (section && pick) section.append(pick.content.cloneNode(true));
})();`;

const filters = visibleKindOptions(recipes.map((recipe) => recipe.data));
---

<Base>
  <div class="intro" data-intro>
    <div class="intro-text">
      <p class="today" data-today></p>
      <h1>{SITE_NAME}</h1>
      <form class="search" role="search" data-search-form>
        <label for="search-input">搜尋菜譜</label>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="菜名、材料或標籤"
          autocomplete="off"
        />
        <!-- 全頁唯一會朗讀的區域；清單區只放一般文字，避免筆數被讀兩次。 -->
        <p
          id="search-status"
          class="search-status"
          role="status"
          set:text={`共 ${recipes.length} 道`}
        />
      </form>
      <a class="meal-link" href="/meal/">配一桌四菜一湯</a>
    </div>

    {
      heroRecipes.length > 0 && (
        <section class="hero-pick" aria-label="隨機推薦菜譜">
          {heroRecipes.map((recipe) => (
            <template data-hero-slot>
              <a href={recipeHref(recipe)}>
                <Illustration
                  image={recipe.data.hero!}
                  sizes="(min-width: 64rem) 36rem, 100vw"
                  priority
                />
                <p class="hero-title">{recipe.data.title}</p>
              </a>
            </template>
          ))}
          <noscript>
            <a href={recipeHref(heroRecipes[0]!)}>
              <Illustration
                image={heroRecipes[0]!.data.hero!}
                sizes="(min-width: 64rem) 36rem, 100vw"
                priority
              />
              <p class="hero-title">{heroRecipes[0]!.data.title}</p>
            </a>
          </noscript>
          <script is:inline set:html={HERO_PICK_SCRIPT} />
        </section>
      )
    }
  </div>

  <section id="recipes" class="recipe-list" aria-labelledby="recipes-title">
    <h2 id="recipes-title">菜譜清單</h2>
    {
      recipes.length === 0 ? (
        <p>目前還沒有菜譜。</p>
      ) : (
        <>
          <div class="list-tools">
            <div class="filters" role="group" aria-label="篩選">
              {filters.map((filter) => (
                <button
                  type="button"
                  data-filter={filter.value}
                  aria-pressed={filter.value === "all" ? "true" : "false"}
                >
                  {filter.label}
                </button>
              ))}
            </div>
          </div>
          <ul class="rows">
            {recipes.map((recipe) => (
              <li
                class="row"
                data-recipe-row
                data-recipe-id={recipe.id}
                data-kinds={recipeKinds(recipe.data).join(" ")}
              >
                {recipe.data.hero && (
                  <Illustration
                    class="thumb"
                    image={recipe.data.hero}
                    sizes="(min-width: 40rem) 120px, 72px"
                    widths={[144, 240, 360]}
                  />
                )}
                <h3>
                  <a href={recipeHref(recipe)}>{recipe.data.title}</a>
                  {recipe.data.draft && <span>（草稿）</span>}
                </h3>
                <p class="row-summary">{recipe.data.summary}</p>
                <span class="kind">{recipe.data.category}</span>
              </li>
            ))}
          </ul>
          <div class="empty" data-empty hidden>
            <p data-empty-message />
            <button type="button" data-clear>
              清除條件
            </button>
          </div>
        </>
      )
    }
  </section>
</Base>

<script>
  import { initHome } from "../scripts/home";

  initHome();
</script>

<style>
  .intro {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  .today {
    margin: 0 0 0.5rem;
    min-height: 1.8em;
    color: var(--ink-soft);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }
  .intro h1 {
    margin: 0 0 2rem;
    writing-mode: vertical-rl;
    font-size: 3rem;
    line-height: 1.1;
    letter-spacing: 0.1em;
  }
  @media (min-width: 64rem) {
    .intro h1 {
      font-size: 4.5rem;
    }
  }
  .search label {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .search input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .search-status {
    margin: 0.5rem 0 0;
    min-height: 1.8em;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .meal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    text-decoration: none;
  }
  .hero-pick a {
    display: block;
    text-decoration: none;
  }
  .hero-title {
    margin: 0.25rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .recipe-list {
    scroll-margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .recipe-list h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }
  .list-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .filters button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }
  .empty {
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .empty p {
    margin: 0 0 1rem;
  }
  .empty button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .row[hidden] {
    display: none;
  }
  .row :global(.thumb) {
    grid-column: 1;
    grid-row: 1 / 4;
  }
  .row h3,
  .row .row-summary,
  .row .kind {
    grid-column: 2;
  }
  .row h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  /* 連結撐滿整列，整列可點，但可聚焦與朗讀的仍只有菜名 */
  .row h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .row h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .row h3 a:focus-visible {
    outline: none;
  }
  .row h3 a:focus-visible::after {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .row-summary {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .kind {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 120px minmax(0, 1fr) auto;
      column-gap: 1.75rem;
      align-items: center;
    }
    .row :global(.thumb) {
      grid-row: 1 / 3;
    }
    .row .kind {
      grid-column: 3;
      grid-row: 1 / 3;
      margin-top: 0;
    }
  }

  /*
   * 手機版（< 40rem）清單密度：首屏收緊讓篩選列落在第一個畫面內、摘要截成 1 行、
   * 篩選列捲動時固定在頂部。寬螢幕版面不受影響。
   */
  @media (max-width: 39.99rem) {
    :global(main) {
      padding-top: 1.5rem;
    }
    .intro {
      margin-bottom: 0;
    }
    /* 直排大字在手機縮小，讓篩選列仍落在第一屏內 */
    .intro h1 {
      margin-bottom: 1.25rem;
      font-size: 2rem;
    }
    /* 成品大圖由腳本複製進來，沒有 Astro 的範圍屬性，所以用 :global；裁切置中 */
    .hero-pick :global(figure.illustration img) {
      aspect-ratio: 2 / 1;
      object-fit: cover;
      object-position: center;
    }
    .list-tools {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    /* 截成 1 行；完整文字仍在 DOM，供螢幕閱讀器與 Pagefind 讀取 */
    .row-summary {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      overflow: hidden;
    }
  }

  /* 手機搜尋中收起成品大圖，結果緊接在搜尋框下方；寬螢幕左文右圖不受影響 */
  @media (max-width: 63.99rem) {
    .intro[data-searching] .hero-pick {
      display: none;
    }
  }

  /* 寬螢幕第一屏：左文右圖 */
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 36rem;
      gap: 4rem;
      align-items: center;
    }
  }
</style>
