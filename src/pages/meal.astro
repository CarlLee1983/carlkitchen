---
import Illustration from "../components/Illustration.astro";
import Base from "../layouts/Base.astro";
import { candidatesFromRecipes } from "../meal-planner/index.ts";
import { getVisibleRecipes, recipeHref } from "../utils/recipes";
import type { MealData } from "../scripts/meal";

const recipes = await getVisibleRecipes();
// 候選池由引擎的轉換函式決定；頁面只多帶顯示用的菜名、連結與縮圖給前端腳本。
const candidates = candidatesFromRecipes(recipes);
const display: MealData["recipes"] = {};
for (const { id } of candidates) {
  const recipe = recipes.find((item) => item.id === id)!;
  display[id] = { title: recipe.data.title, href: recipeHref(recipe) };
}
const thumbRecipes = candidates.flatMap(({ id }) => {
  const recipe = recipes.find((item) => item.id === id)!;
  return recipe.data.hero ? [{ id, hero: recipe.data.hero }] : [];
});
const data: MealData = { candidates, recipes: display };
// 內嵌在 JSON script 中，避免標題含 `<` 時提早結束標籤。
const dataJson = JSON.stringify(data).replace(/</g, "\\u003c");
---

<Base
  title="配一桌菜"
  description="從配菜候選中抽出或自選四菜一湯、五菜一湯，搭配今天的一桌家常菜。"
>
  <section class="meal-page" aria-labelledby="meal-title">
    <header class="meal-heading">
      <p class="meal-eyebrow">今日餐桌・自由配搭</p>
      <h1 id="meal-title">配一桌菜</h1>
      <p class="meal-intro">
        從配菜候選抽出一桌家常菜，也可以從空白開始逐道自選。
      </p>
    </header>

    <section class="meal-builder" aria-label="設定菜單">
      <div class="meal-builder-copy">
        <span class="meal-step"
          >01 <span aria-hidden="true">/</span> 選擇桌菜份量</span
        >
        <span class="meal-builder-hint">配菜與湯品會一併安排</span>
      </div>
      <div class="meal-tools">
        <div class="meal-modes" role="group" aria-label="菜數">
          <button type="button" data-mode="4" aria-pressed="true">
            <span class="meal-mode-count" aria-hidden="true">04</span>
            <span class="meal-mode-name">四菜一湯</span>
            <span class="meal-mode-check" aria-hidden="true">✓</span>
          </button>
          <button type="button" data-mode="5" aria-pressed="false">
            <span class="meal-mode-count" aria-hidden="true">05</span>
            <span class="meal-mode-name">五菜一湯</span>
            <span class="meal-mode-check" aria-hidden="true">✓</span>
          </button>
        </div>
        <div class="meal-primary-actions">
          <button type="button" class="meal-reroll" data-reroll>
            <span>重新抽選</span>
            <svg
              class="meal-reroll-mark"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M20 7v5h-5M4.8 9a7.5 7.5 0 0 1 12.7-2L20 9M4 17v-5h5m10.2 3a7.5 7.5 0 0 1-12.7 2L4 15"
              ></path>
            </svg>
          </button>
          <button type="button" class="meal-self-select" data-self-select>
            <span class="meal-self-mark" aria-hidden="true">＋</span>
            從空白自選
          </button>
        </div>
      </div>
    </section>

    <div class="meal-share" role="group" aria-label="分享菜單">
      <span class="meal-share-label">帶走這份菜單</span>
      <button type="button" data-copy-meal disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8 8.5h9.5A1.5 1.5 0 0 1 19 10v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 7 19v-9A1.5 1.5 0 0 1 8.5 8.5ZM5 15.5H4.5A1.5 1.5 0 0 1 3 14V5.5A1.5 1.5 0 0 1 4.5 4h9A1.5 1.5 0 0 1 15 5.5V6"
          ></path>
        </svg>
        複製菜單連結
      </button>
      <button type="button" data-share-meal disabled hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 13v6.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V13"
          ></path>
        </svg>
        分享菜單
      </button>
    </div>

    <section class="meal-results" aria-label="抽選結果">
      <div class="meal-results-heading">
        <div>
          <p class="meal-step">02 <span aria-hidden="true">/</span> 本桌菜色</p>
          <p class="meal-results-note">點菜名查看做法，也可搜尋或指定菜色。</p>
        </div>
        <span class="meal-results-stamp" aria-hidden="true">家常<br />菜單</span
        >
      </div>

      <!-- 全頁唯一會朗讀的區域；其餘訊息只放一般文字，避免重複朗讀。 -->
      <p class="meal-status" role="status" data-status></p>

      <p class="meal-empty" data-empty>
        <span class="meal-empty-mark" aria-hidden="true"
          >尚未抽選・一桌好菜，從這裡開始</span
        >
        選擇「重新抽選」，或從空白開始逐道挑選菜色。
      </p>
      <ol class="meal-plan" aria-label="本桌菜色" data-plan></ol>
    </section>

    <noscript><p>配菜功能需要啟用 JavaScript。</p></noscript>

    {
      thumbRecipes.map(({ id, hero }) => (
        <template data-thumb={id}>
          <Illustration
            class="thumb"
            image={hero}
            sizes="(min-width: 42rem) 112px, 64px"
            widths={[144, 240, 360]}
          />
        </template>
      ))
    }
    <script type="application/json" id="meal-data" set:html={dataJson} />
  </section>
</Base>

<script>
  import { initMeal } from "../scripts/meal";

  initMeal();
</script>

<style is:global>
  .meal-page {
    --meal-accent: #657052;
    --meal-accent-dark: #4e593e;
    --meal-accent-wash: #edf0e7;
    max-width: 58rem;
    margin: 0 auto;
  }
  .meal-heading {
    max-width: 39rem;
    padding: 1.25rem 0 3rem;
  }
  .meal-eyebrow,
  .meal-step {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .meal-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .meal-eyebrow::before {
    width: 1.5rem;
    height: 1px;
    background: var(--ink-soft);
    content: "";
  }
  .meal-heading h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 1.18;
    text-wrap: balance;
  }
  .meal-intro {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .meal-builder {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 1.5rem;
    padding: 1.35rem 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .meal-builder-copy {
    display: grid;
    gap: 0.25rem;
  }
  .meal-builder-hint,
  .meal-results-note {
    color: var(--ink-soft);
    font-size: 0.84rem;
  }
  .meal-step span {
    padding: 0 0.2rem;
    color: #a49f95;
  }
  .meal-tools {
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }
  .meal-modes {
    display: flex;
    gap: 0.5rem;
  }
  .meal-modes button {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    min-width: 9rem;
    min-height: 3.5rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }
  .meal-modes button[aria-pressed="true"] {
    border-color: var(--meal-accent);
    background: var(--meal-accent-wash);
    color: var(--meal-accent-dark);
  }
  .meal-mode-count {
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .meal-modes button[aria-pressed="true"] .meal-mode-count {
    color: var(--meal-accent);
  }
  .meal-mode-name {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .meal-mode-check {
    display: grid;
    width: 1.2rem;
    height: 1.2rem;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 50%;
    color: transparent;
    font-size: 0.68rem;
    line-height: 1;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .meal-modes button[aria-pressed="true"] .meal-mode-check {
    border-color: var(--meal-accent);
    background: var(--meal-accent);
    color: #fff;
  }
  .meal-primary-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .meal-reroll,
  .meal-self-select,
  .meal-share button,
  .meal-item button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--ink);
    border-radius: 0.3rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }
  .meal-reroll {
    min-width: 9.5rem;
    background: var(--meal-accent);
    color: var(--paper);
    font-weight: 600;
    box-shadow: 0 3px 0 var(--meal-accent-dark);
  }
  .meal-reroll-mark {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .meal-reroll:hover {
    border-color: var(--meal-accent-dark);
    background: var(--meal-accent-dark);
  }
  .meal-reroll:hover .meal-reroll-mark {
    transform: rotate(-45deg);
  }
  .meal-self-select {
    border-color: transparent;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .meal-self-select:hover {
    border-color: var(--line);
    background: #f1efe9;
    color: var(--ink);
  }
  .meal-self-mark {
    color: var(--meal-accent);
    font-size: 1.15rem;
    line-height: 1;
  }
  .meal-modes button:hover:not([aria-pressed="true"]) {
    border-color: #b9b6ac;
    background: #f1efe9;
    color: var(--ink);
  }
  .meal-reroll:active,
  .meal-self-select:active,
  .meal-share button:active,
  .meal-item button:active,
  .meal-modes button:active {
    transform: translateY(1px);
  }
  .meal-page button:focus-visible,
  .meal-page input:focus-visible,
  .meal-page select:focus-visible {
    outline: 2px solid var(--meal-accent);
    outline-offset: 3px;
  }
  .meal-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    padding: 0.7rem 0 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .meal-share-label {
    margin-right: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }
  .meal-share button {
    min-height: 44px;
    padding: 0 0.7rem;
    border-color: transparent;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  .meal-share button:hover:not(:disabled) {
    border-color: var(--line);
    background: #f1efe9;
    color: var(--ink);
  }
  .meal-share button:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }
  .meal-share svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
  .meal-results {
    padding-top: 2.5rem;
  }
  .meal-results-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--ink);
  }
  .meal-results-note {
    margin: 0.2rem 0 0;
  }
  .meal-results-stamp {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.68rem;
    line-height: 1.35;
    text-align: center;
    transform: rotate(8deg);
  }
  .meal-status {
    margin: 0;
    min-height: 2.5rem;
    padding-top: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .meal-empty {
    display: grid;
    min-height: 10rem;
    align-content: center;
    justify-items: start;
    gap: 0.4rem;
    margin: 0;
    padding: 1.5rem 0 2rem 1rem;
    border-left: 2px solid #b4aa8f;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .meal-empty[hidden] {
    display: none;
  }
  .meal-empty-mark {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
  }
  .meal-plan {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .meal-item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: 1rem;
    row-gap: 0.1rem;
    align-items: center;
    min-height: 8rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .meal-item .thumb {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.25rem;
    background: #eeece6;
  }
  .meal-item .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meal-slot {
    grid-column: 2;
    align-self: end;
    color: var(--ink-soft);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .meal-item h2 {
    grid-column: 2;
    align-self: center;
    margin: 0;
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
  }
  .meal-item h2 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 160ms ease;
  }
  .meal-item h2 a:hover {
    text-decoration-color: currentColor;
  }
  .meal-actions {
    grid-column: 2;
    align-self: start;
    display: grid;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
  .meal-pickers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 0.75rem;
  }
  .meal-quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .meal-actions label {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .meal-actions input,
  .meal-actions select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    max-width: 100%;
    padding: 0 0.65rem;
    border: 1px solid #d2cfc5;
    border-radius: 0.3rem;
    background: #fbfaf7;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .meal-actions input:hover,
  .meal-actions select:hover {
    border-color: var(--meal-accent);
  }
  .meal-search-hint {
    width: 100%;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }
  .meal-item button {
    min-height: 44px;
    padding: 0 0.8rem;
    border-color: #d2cfc5;
    border-radius: 2rem;
    background: #fbfaf7;
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .meal-item button:hover {
    border-color: var(--meal-accent);
    background: var(--meal-accent);
    color: var(--paper);
  }
  .meal-item button[aria-pressed="true"] {
    border-color: var(--meal-accent);
    background: var(--meal-accent);
    color: var(--paper);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 22%);
  }
  .meal-item button[aria-pressed="true"]:hover {
    background: var(--meal-accent-dark);
  }
  .meal-item button[data-action="toggle"]::before {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: "";
    transition: background-color 160ms ease;
  }
  .meal-item button[data-action="toggle"][aria-pressed="true"]::before {
    background: currentColor;
    box-shadow: inset 0 0 0 1px var(--meal-accent);
  }
  .meal-item button[data-action="replace"]::before {
    content: "↻";
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }
  .meal-item button[data-action="replace"]:hover::before {
    transform: rotate(-45deg);
  }
  @media (min-width: 40rem) {
    .meal-item {
      grid-template-columns: 112px minmax(0, 1fr);
      column-gap: 1.5rem;
      min-height: 9rem;
      padding: 1.25rem 0;
    }
    .meal-item .thumb {
      border-radius: 0.35rem;
    }
  }
  @media (max-width: 50rem) {
    .meal-builder {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding: 1rem 0;
    }
    .meal-tools {
      justify-items: stretch;
    }
    .meal-modes {
      justify-content: flex-start;
    }
    .meal-primary-actions {
      justify-content: flex-start;
    }
  }
  @media (max-width: 42rem) {
    .meal-heading {
      padding: 0.5rem 0 2.25rem;
    }
    .meal-results {
      padding-top: 2rem;
    }
    .meal-item {
      grid-template-columns: 64px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 0.9rem;
      min-height: 8rem;
      padding: 0.85rem 0;
    }
    .meal-actions {
      grid-column: 1 / -1;
      padding-top: 0.75rem;
    }
    .meal-pickers {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 22rem) {
    .meal-modes button {
      flex: 1;
      min-width: 0;
      gap: 0.35rem;
      padding-inline: 0.45rem;
    }
    .meal-mode-name {
      font-size: 0.78rem;
    }
    .meal-mode-check {
      width: 1rem;
      height: 1rem;
    }
    .meal-primary-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .meal-reroll,
    .meal-self-select {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .meal-page *,
    .meal-page *::before,
    .meal-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
