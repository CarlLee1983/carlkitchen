---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: { src: ImageMetadata; alt: string };
  /** 圖在各寬度下實際佔的版面寬度，瀏覽器據此從 srcset 選圖。 */
  sizes: string;
  class?: string;
}
const { image, sizes, class: className } = Astro.props;
---

<figure class:list={["illustration", className]}>
  <Image src={image.src} alt={image.alt} sizes={sizes} />
  <figcaption>AI 繪製插畫</figcaption>
</figure>
