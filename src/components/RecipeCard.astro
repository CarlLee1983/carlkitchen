---
import Illustration from "./Illustration.astro";
import { recipeHref, type Recipe } from "../utils/recipes";

interface Props {
  recipe: Recipe;
  /** 卡片中圖的實際顯示寬度，由放卡片的版面決定。 */
  sizes: string;
}
const { recipe, sizes } = Astro.props;
const { title, hero } = recipe.data;
// 連結的可及名稱只要菜名，不先唸成品圖的替代文字。
const titleId = `recipe-card-title-${recipe.id}`;
---

<a class="recipe-card" href={recipeHref(recipe)} aria-labelledby={titleId}>
  {hero && <Illustration image={hero} sizes={sizes} widths={[320, 480, 640]} />}
  <span class="recipe-card-title" id={titleId}>{title}</span>
</a>

<style>
  .recipe-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .recipe-card-title {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    line-height: 1.5;
    text-underline-offset: 0.25em;
  }
  .recipe-card:hover .recipe-card-title {
    text-decoration: underline;
  }
</style>
