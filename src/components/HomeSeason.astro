---
import { getCollection } from "astro:content";
import HomeTopic from "./HomeTopic.astro";
import Illustration from "./Illustration.astro";
import { buildSolarTermSchedule } from "../utils/solar-term-schedule";
import { inlineJson } from "../utils/inline-json";
import { solarTermIllustration } from "../utils/solar-term-art";
import { solarTermArt, type SolarTermName } from "../utils/solar-terms";
import type { TopicEntry } from "../utils/topic-entries";

interface Props {
  topics: TopicEntry[];
}

const names = Object.keys(solarTermArt) as SolarTermName[];
const schedule = buildSolarTermSchedule();
// 空集合規則：沒有節氣資料就沒有總覽頁，節氣列也不加連結。
const linked = (await getCollection("solarTerms")).length > 0;
const Row = linked ? "a" : "div";
---

{/* 專題在上、節氣在下；兩列都隱藏時整區不顯示。 */}
<section class="season" aria-labelledby="season-title">
  <p class="kicker" id="season-title">這個時節</p>
  <HomeTopic topics={Astro.props.topics} />
  {
    /* 節氣依讀者當下時間由腳本挑選，靜態輸出不預填，免得停在建置當下的節氣；
       取捨同 docs/adr/0006-browser-topic-scheduling.md。 */
  }
  <Row class="term" data-solar-term hidden />
  {
    names.map((name) => (
      <template data-solar-term-slot={name}>
        <Illustration
          image={solarTermIllustration(name)}
          sizes="64px"
          width={128}
        />
        <span class="copy">
          <strong>{name}</strong>
          <span>
            <time data-solar-term-time /> 交節
            <small data-solar-term-source />
          </span>
        </span>
      </template>
    ))
  }
  <script
    type="application/json"
    data-solar-term-schedule
    set:html={inlineJson(schedule)}
  />
</section>

<script>
  import {
    fillSolarTermTime,
    readSolarTermSchedule,
  } from "../utils/solar-term-client";
  import { solarTermSourceLabel } from "../utils/solar-term-display";
  import {
    selectSolarTerm,
    solarTermArt,
    type SolarTermName,
  } from "../utils/solar-terms";
  const row = document.querySelector<HTMLElement>("[data-solar-term]");
  const selected = selectSolarTerm(readSolarTermSchedule());
  const template = document.querySelector<HTMLTemplateElement>(
    `[data-solar-term-slot="${selected?.name}"]`,
  );
  if (row && selected && template) {
    const content = template.content.cloneNode(true) as DocumentFragment;
    fillSolarTermTime(content.querySelector("time")!, selected);
    content.querySelector("[data-solar-term-source]")!.textContent =
      solarTermSourceLabel(selected.source);
    row.replaceChildren(content);
    if (row instanceof HTMLAnchorElement) {
      row.href = `/solar-terms/#${solarTermArt[selected.name as SolarTermName]}`;
    }
    row.hidden = false;
  }
</script>

<style>
  .season {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }
  .season:not(
    :has(> [data-home-topic]:not([hidden]), > [data-solar-term]:not([hidden]))
  ) {
    display: none;
  }
  .kicker {
    margin: 0 0 0.25rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .term {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    height: 48px;
    margin-top: 0.5rem;
  }
  a.term {
    color: inherit;
    text-decoration: none;
  }
  a.term:hover strong {
    text-decoration: underline;
  }
  .term[hidden] {
    display: none;
  }
  .term :global(figure) {
    flex: 0 0 64px;
    margin: 0;
  }
  .term :global(img) {
    display: block;
    width: 64px;
    height: 43px;
    object-fit: cover;
  }
  .copy {
    display: block;
    min-width: 0;
  }
  .copy strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1rem;
  }
  .copy > span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  .copy small {
    margin-left: 0.5em;
    font-size: 0.7rem;
  }
  /* 手機只留一行文字，不顯示插畫，少佔首屏高度。 */
  /* 間距與行高一併收緊，讓第一道菜名仍留在 390×844 首屏內。 */
  @media (max-width: 39.99rem) {
    .season {
      margin-top: 0.5rem;
    }
    .kicker {
      margin-bottom: 0.125rem;
      line-height: 1.4;
    }
    /* 插畫不顯示，文字仍對齊專題列的文字欄（64px 縮圖加間距）。 */
    .term {
      height: auto;
      margin-top: 0.125rem;
      padding-left: calc(64px + 0.75rem);
      line-height: 1.25;
    }
    .term :global(figure) {
      display: none;
    }
    .copy {
      display: flex;
      gap: 0.75em;
      align-items: baseline;
      min-width: 0;
    }
    .copy strong {
      flex: none;
    }
  }
</style>
